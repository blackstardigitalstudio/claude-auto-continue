#!/usr/bin/env bash
# =============================================================================
# claude-ac â Auto-Continue wrapper for Claude Code
# =============================================================================
# Wraps the `claude` CLI and automatically resumes sessions when API usage
# limits are reached, without any manual intervention.
#
# Usage:
#   claude-ac [any claude options and prompt]
#   claude-ac --ac-interval 600 --ac-retries 6 "build me an app"
#
# Project: https://github.com/YOUR_USERNAME/claude-auto-continue
# License: MIT
# =============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$(cd "$SCRIPT_DIR/../lib" && pwd)"
CONFIG_DIR="$(cd "$SCRIPT_DIR/../config" && pwd)"

# shellcheck source=../lib/detect.sh
source "$LIB_DIR/detect.sh"
# shellcheck source=../lib/notify.sh
source "$LIB_DIR/notify.sh"
# shellcheck source=../lib/session.sh
source "$LIB_DIR/session.sh"
# shellcheck source=../config/defaults.sh
source "$CONFIG_DIR/defaults.sh"

# Override defaults from environment
RETRY_INTERVAL="${CLAUDE_AC_INTERVAL:-$DEFAULT_RETRY_INTERVAL}"
MAX_RETRIES="${CLAUDE_AC_MAX_RETRIES:-$DEFAULT_MAX_RETRIES}"
CLAUDE_BIN="${CLAUDE_BIN:-claude}"
LOG_FILE="${CLAUDE_AC_LOG:-$DEFAULT_LOG_FILE}"
VERBOSE="${CLAUDE_AC_VERBOSE:-0}"
NOTIFY="${CLAUDE_AC_NOTIFY:-$DEFAULT_NOTIFY}"

# Internal state
_SESSION_TMP=""
_RETRY_COUNT=0
_SESSION_CWD="$PWD"
_START_TIME=$(date +%s)

# ---------------------------------------------------------------------------
# Logging helpers
# ---------------------------------------------------------------------------

log() {
    local level="$1"; shift
    local msg="$*"
    local ts
    ts=$(date '+%H:%M:%S')
    case "$level" in
        INFO)  echo "  â¬¡ claude-ac [$ts] $msg" ;;
        WAIT)  echo "  â¸ claude-ac [$ts] $msg" ;;
        RETRY) echo "  ð claude-ac [$ts] $msg" ;;
        DONE)  echo "  â claude-ac [$ts] $msg" ;;
        FAIL)  echo "  â claude-ac [$ts] $msg" >&2 ;;
        DEBUG) [[ "$VERBOSE" == "1" ]] && echo "  Â· claude-ac [$ts] $msg" || true ;;
    esac

    # Append to log file
    mkdir -p "$(dirname "$LOG_FILE")"
    echo "[$level $ts] $msg" >> "$LOG_FILE"
}

# ---------------------------------------------------------------------------
# Parse auto-continue flags (strip them before passing to claude)
# ---------------------------------------------------------------------------

parse_ac_flags() {
    local -a filtered_args=()
    local skip_next=0

    for arg in "$@"; do
        if [[ "$skip_next" == "1" ]]; then
            skip_next=0
            continue
        fi
        case "$arg" in
            --ac-interval=*) RETRY_INTERVAL="${arg#*=}" ;;
            --ac-interval)   skip_next=1; RETRY_INTERVAL="${!OPTIND:-$RETRY_INTERVAL}" ;;
            --ac-retries=*)  MAX_RETRIES="${arg#*=}" ;;
            --ac-retries)    skip_next=1 ;;
            --ac-verbose)    VERBOSE=1 ;;
            --ac-no-notify)  NOTIFY=0 ;;
            --ac-help)       show_help; exit 0 ;;
            *)               filtered_args+=("$arg") ;;
        esac
    done

    CLAUDE_ARGS=("${filtered_args[@]}")
}

show_help() {
    cat <<EOF
claude-ac â Auto-Continue wrapper for Claude Code

Usage: claude-ac [--ac-*] [claude options] [prompt]

Auto-Continue options:
  --ac-interval <secs>   Seconds to wait between retries (default: $DEFAULT_RETRY_INTERVAL)
  --ac-retries <n>       Maximum retry attempts (default: $DEFAULT_MAX_RETRIES)
  --ac-verbose           Enable verbose logging
  --ac-no-notify         Disable desktop notifications
  --ac-help              Show this help

Environment variables:
  CLAUDE_AC_INTERVAL     Override retry interval
  CLAUDE_AC_MAX_RETRIES  Override max retries
  CLAUDE_AC_LOG          Log file path (default: $DEFAULT_LOG_FILE)
  CLAUDE_AC_NOTIFY       Set to 0 to disable notifications
  CLAUDE_BIN             Path to claude binary (default: claude)

Examples:
  claude-ac "build me a todo app"
  claude-ac --ac-interval 600 -p "write tests for main.py"
  CLAUDE_AC_INTERVAL=300 claude-ac --continue

When credits are exhausted, claude-ac will:
  1. Detect the usage limit message in the output
  2. Wait \$RETRY_INTERVAL seconds (default: 5 minutes for testing, increase for production)
  3. Automatically run 'claude --continue' to resume your session
  4. Send a desktop notification when resuming (if supported)

EOF
}

# ---------------------------------------------------------------------------
# Cleanup on exit
# ---------------------------------------------------------------------------

cleanup() {
    [[ -n "$_SESSION_TMP" && -f "$_SESSION_TMP" ]] && rm -f "$_SESSION_TMP"
}
trap cleanup EXIT INT TERM

# ---------------------------------------------------------------------------
# Core retry loop
# ---------------------------------------------------------------------------

run_with_auto_continue() {
    local -a args=("$@")

    while true; do
        _SESSION_TMP=$(mktemp /tmp/claude-ac-XXXXXX.log)
        log DEBUG "Running: $CLAUDE_BIN ${args[*]}"
        log DEBUG "Output capture: $_SESSION_TMP"

        # Run claude, tee output to terminal AND our capture file
        # We use a subshell with pipefail to capture the real exit code
        local exit_code=0
        "$CLAUDE_BIN" "${args[@]}" 2>&1 | tee "$_SESSION_TMP" || exit_code=$?

        log DEBUG "Exit code: $exit_code"

        # ââ Check if we should retry ââââââââââââââââââââââââââââââââââââââ
        if should_retry "$_SESSION_TMP" "$exit_code"; then
            _RETRY_COUNT=$((_RETRY_COUNT + 1))

            if [[ $_RETRY_COUNT -gt $MAX_RETRIES ]]; then
                log FAIL "Reached maximum retry limit ($MAX_RETRIES). Giving up."
                notify_send "Claude Auto-Continue" \
                    "Max retries reached ($MAX_RETRIES). Manual intervention needed." \
                    "warning"
                exit 1
            fi

            # Try to extract the reset time from the output
            local wait_secs
            wait_secs=$(extract_wait_time "$_SESSION_TMP" "$RETRY_INTERVAL")

            local resume_at
            resume_at=$(date -d "+${wait_secs} seconds" '+%H:%M:%S' 2>/dev/null \
                     || date -v+${wait_secs}S '+%H:%M:%S' 2>/dev/null \
                     || echo "~${wait_secs}s from now")

            log WAIT "Usage limit detected. Retry $_RETRY_COUNT/$MAX_RETRIES"
            log WAIT "Waiting ${wait_secs}s â will resume at $resume_at"

            notify_send "Claude Auto-Continue" \
                "Credits exhausted. Resuming at $resume_at (retry $_RETRY_COUNT/$MAX_RETRIES)." \
                "info"

            # Show a countdown so the user knows we're alive
            countdown "$wait_secs"

            log RETRY "Resuming session with 'claude --continue'..."
            notify_send "Claude Auto-Continue" "Resuming now..." "info"

            # Switch to --continue for all subsequent attempts
            args=("--continue" "${args[@]}")
            # Remove any duplicate --continue flags
            # shellcheck disable=SC2207
            args=($(printf '%s\n' "${args[@]}" | awk '!seen[$0]++ || $0 != "--continue"'))

        else
            # ââ Clean exit or non-credit error ââââââââââââââââââââââââââ
            if [[ $exit_code -eq 0 ]]; then
                log DONE "Session completed successfully."
            else
                log FAIL "Session exited with code $exit_code (not a usage-limit error)."
            fi
            exit $exit_code
        fi
    done
}

# ---------------------------------------------------------------------------
# Countdown display
# ---------------------------------------------------------------------------

countdown() {
    local secs="$1"
    local interval=30  # Update every 30 seconds
    local elapsed=0

    while [[ $elapsed -lt $secs ]]; do
        local remaining=$(( secs - elapsed ))
        local mins=$(( remaining / 60 ))
        local s=$(( remaining % 60 ))
        printf "\r  â³ claude-ac: %02d:%02d remaining until retry..." "$mins" "$s"
        sleep "$interval" &
        wait $! 2>/dev/null || true
        elapsed=$(( elapsed + interval ))
    done
    printf "\r  â claude-ac: Wait complete.                              \n"
}

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

main() {
    # Handle no-args case
    if [[ $# -eq 0 ]]; then
        show_help
        exit 0
    fi

    parse_ac_flags "$@"

    log INFO "claude-ac v${CLAUDE_AC_VERSION:-dev} â Auto-Continue enabled"
    log INFO "Max retries: $MAX_RETRIES | Interval: ${RETRY_INTERVAL}s | Notify: $NOTIFY"
    log DEBUG "Args passed to claude: ${CLAUDE_ARGS[*]:-<none>}"

    run_with_auto_continue "${CLAUDE_ARGS[@]}"
}

main "$@"
