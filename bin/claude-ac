#!/usr/bin/env bash
# =============================================================================
# claude-ac — Auto-Continue wrapper per Claude Code (v1.1)
# =============================================================================
# Avvolge la CLI `claude` e riprende automaticamente le sessioni quando si
# raggiungono i limiti di utilizzo, senza intervento manuale.
#
# Uso:
#   claude-ac [opzioni claude e prompt]
#   claude-ac --ac-interval 600 --ac-retries 6 "costruiscimi un'app"
#
# Progetto: https://github.com/blackstardigitalstudio/claude-auto-continue
# Licenza: MIT — Made in Italy
# =============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$(cd "$SCRIPT_DIR/../lib" && pwd)"
CONFIG_DIR="$(cd "$SCRIPT_DIR/../config" && pwd)"

source "$LIB_DIR/detect.sh"
source "$LIB_DIR/notify.sh"
source "$LIB_DIR/session.sh"
source "$CONFIG_DIR/defaults.sh"

RETRY_INTERVAL="${CLAUDE_AC_INTERVAL:-$DEFAULT_RETRY_INTERVAL}"
MAX_RETRIES="${CLAUDE_AC_MAX_RETRIES:-$DEFAULT_MAX_RETRIES}"
CLAUDE_BIN="${CLAUDE_BIN:-claude}"
LOG_FILE="${CLAUDE_AC_LOG:-$DEFAULT_LOG_FILE}"
VERBOSE="${CLAUDE_AC_VERBOSE:-0}"
NOTIFY="${CLAUDE_AC_NOTIFY:-$DEFAULT_NOTIFY}"

_SESSION_TMP=""
_RETRY_COUNT=0
_START_TIME=$(date +%s)
CLAUDE_ARGS=()

log() {
    local level="$1"; shift
    local msg="$*" ts; ts=$(date '+%H:%M:%S')
    case "$level" in
        INFO)  echo "  ⬡ claude-ac [$ts] $msg" ;;
        WAIT)  echo "  ⏸ claude-ac [$ts] $msg" ;;
        RETRY) echo "  ↻ claude-ac [$ts] $msg" ;;
        DONE)  echo "  ✓ claude-ac [$ts] $msg" ;;
        FAIL)  echo "  ✗ claude-ac [$ts] $msg" >&2 ;;
        DEBUG) [[ "$VERBOSE" == "1" ]] && echo "  · claude-ac [$ts] $msg" || true ;;
    esac
    mkdir -p "$(dirname "$LOG_FILE")"
    echo "[$level $ts] $msg" >> "$LOG_FILE"
}

# ---------------------------------------------------------------------------
# Parsing flag --ac-* (while + shift: gestisce correttamente i valori)
# ---------------------------------------------------------------------------
parse_ac_flags() {
    local -a filtered=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --ac-interval=*) RETRY_INTERVAL="${1#*=}" ;;
            --ac-interval)   shift; RETRY_INTERVAL="${1:-$RETRY_INTERVAL}" ;;
            --ac-retries=*)  MAX_RETRIES="${1#*=}" ;;
            --ac-retries)    shift; MAX_RETRIES="${1:-$MAX_RETRIES}" ;;
            --ac-verbose)    VERBOSE=1 ;;
            --ac-no-notify)  NOTIFY=0 ;;
            --ac-help)       show_help; exit 0 ;;
            *)               filtered+=("$1") ;;
        esac
        shift
    done
    # Validazione numerica
    [[ "$RETRY_INTERVAL" =~ ^[0-9]+$ ]] || { echo "Intervallo non valido" >&2; exit 2; }
    [[ "$MAX_RETRIES"   =~ ^[0-9]+$ ]] || { echo "Numero retry non valido" >&2; exit 2; }
    CLAUDE_ARGS=("${filtered[@]}")
}

show_help() {
    cat <<HELP
claude-ac — Auto-Continue per Claude Code (v${CLAUDE_AC_VERSION:-dev})

Uso: claude-ac [--ac-*] [opzioni claude] [prompt]

Opzioni Auto-Continue:
  --ac-interval <sec>   Attesa tra i tentativi (default: $DEFAULT_RETRY_INTERVAL)
  --ac-retries <n>      Numero massimo di tentativi (default: $DEFAULT_MAX_RETRIES)
  --ac-verbose          Log dettagliato
  --ac-no-notify        Disabilita le notifiche desktop
  --ac-help             Mostra questo aiuto

Variabili d'ambiente:
  CLAUDE_AC_INTERVAL, CLAUDE_AC_MAX_RETRIES, CLAUDE_AC_LOG,
  CLAUDE_AC_NOTIFY (0=off), CLAUDE_BIN

Esempi:
  claude-ac "costruiscimi una todo app"
  claude-ac --ac-interval 600 -p "scrivi i test per main.py"

Made in Italy 🇮🇹 — https://github.com/blackstardigitalstudio/claude-auto-continue
HELP
}

cleanup() {
    # Preserva il codice di uscita previsto: senza catturarlo, l'esito
    # dell'ultimo comando della trap sovrascriverebbe `exit 0` (es. --ac-help).
    local rc=$?
    [[ -n "$_SESSION_TMP" && -f "$_SESSION_TMP" ]] && rm -f "$_SESSION_TMP"
    return "$rc"
}
trap cleanup EXIT INT TERM

# ---------------------------------------------------------------------------
# Aggiunge --continue una sola volta (senza word-splitting pericoloso)
# ---------------------------------------------------------------------------
ensure_continue_flag() {
    local a
    for a in "${args[@]}"; do
        [[ "$a" == "--continue" ]] && return 0
    done
    args=("--continue" "${args[@]}")
}

countdown() {
    local secs="$1" interval=30 elapsed=0 remaining mins s
    while [[ $elapsed -lt $secs ]]; do
        remaining=$(( secs - elapsed )); mins=$(( remaining / 60 )); s=$(( remaining % 60 ))
        printf "\r  ⏳ claude-ac: %02d:%02d al prossimo tentativo..." "$mins" "$s"
        sleep "$interval" 2>/dev/null || true
        elapsed=$(( elapsed + interval ))
    done
    printf "\r  ✓ claude-ac: attesa completata.                          \n"
}

run_with_auto_continue() {
    local -a args=("$@")
    while true; do
        # NB: i template di mktemp devono terminare con le X (compatibilità BSD/macOS).
        _SESSION_TMP=$(mktemp "${TMPDIR:-/tmp}/claude-ac-XXXXXX")
        log DEBUG "Eseguo: $CLAUDE_BIN ${args[*]:-}"

        local exit_code=0
        "$CLAUDE_BIN" "${args[@]}" 2>&1 | tee "$_SESSION_TMP" || exit_code=${PIPESTATUS[0]}
        log DEBUG "Exit code: $exit_code"

        if should_retry "$_SESSION_TMP" "$exit_code"; then
            _RETRY_COUNT=$(( _RETRY_COUNT + 1 ))
            if [[ $_RETRY_COUNT -gt $MAX_RETRIES ]]; then
                log FAIL "Raggiunto il limite di tentativi ($MAX_RETRIES). Mi fermo."
                notify_send "Claude Auto-Continue" "Max tentativi raggiunti ($MAX_RETRIES)." "warning"
                exit 1
            fi
            local wait_secs resume_at
            wait_secs=$(extract_wait_time "$_SESSION_TMP" "$RETRY_INTERVAL")
            resume_at=$(date -d "+${wait_secs} seconds" '+%H:%M:%S' 2>/dev/null \
                     || date -v+${wait_secs}S '+%H:%M:%S' 2>/dev/null || echo "~${wait_secs}s")
            log WAIT "Limite rilevato. Tentativo $_RETRY_COUNT/$MAX_RETRIES — ripresa alle $resume_at"
            notify_send "Claude Auto-Continue" "Crediti esauriti. Riprendo alle $resume_at." "info"
            countdown "$wait_secs"
            log RETRY "Riprendo con 'claude --continue'..."
            ensure_continue_flag
        else
            if [[ $exit_code -eq 0 ]]; then
                log DONE "Sessione completata con successo."
            else
                log FAIL "Sessione uscita con codice $exit_code (non è un limite di utilizzo)."
            fi
            exit "$exit_code"
        fi
    done
}

main() {
    [[ $# -eq 0 ]] && { show_help; exit 0; }
    parse_ac_flags "$@"
    log INFO "claude-ac v${CLAUDE_AC_VERSION:-dev} — Auto-Continue attivo"
    log INFO "Max retry: $MAX_RETRIES | Intervallo: ${RETRY_INTERVAL}s | Notifiche: $NOTIFY"
    run_with_auto_continue "${CLAUDE_ARGS[@]}"
}

main "$@"
